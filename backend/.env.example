# Application
APP_NAME=MedServicePrice
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS — comma-separated origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Admin key — required for all /scheduler/* endpoints
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=change-me-before-deploy

# PostgreSQL
POSTGRES_USER=medprice
POSTGRES_PASSWORD=medprice
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=medprice
